# ===========================================
# Calricula frontend environment (example)
# ===========================================
# Copy to `.env.local` and fill in. Never commit the filled-in file.

# Backend origin used by browser code (dev ports are shifted: FE 3001, BE 8001).
NEXT_PUBLIC_API_URL=http://localhost:8001

# -------------------------------------------
# Sign-in mode (client-visible flags)
# -------------------------------------------
# Dev identity picker: email + `Test123!` for the seeded accounts, no provider
# needed. Wins over Logto when both are set. Never enable in production.
NEXT_PUBLIC_AUTH_DEV_MODE=true

# Advertise Logto single sign-on to the browser. Set this to `true` only when
# every LOGTO_* variable below is set; it is deliberately not derived from them.
NEXT_PUBLIC_LOGTO_ENABLED=false

# -------------------------------------------
# Logto (server-only — never prefixed NEXT_PUBLIC_, never sent to the browser)
# -------------------------------------------
# All five are required; while any is missing every auth route returns 404.
# Your Logto tenant endpoint, e.g. https://xxxx.logto.app/
# LOGTO_ENDPOINT=
# The "Traditional web" application's App ID (docs/AUTH-LOGTO.md §2; the
# Next.js App Router guide is the framework integration, not the app type).
# LOGTO_APP_ID=
# That application's App Secret.
# LOGTO_APP_SECRET=
# Key used to encrypt the session cookie: `openssl rand -base64 32`.
# LOGTO_COOKIE_SECRET=
# API resource indicator; must equal the backend's OIDC_AUDIENCE.
# LOGTO_API_RESOURCE=https://api.calricula.local

# ApplicationX API resource indicator, for the embedded-workspace broker.
# Required (in Logto mode) whenever the backend has APPLICATIONX_EMBED_ENABLED
# =true; the frontend requests this token via getToken('applicationx').
# Without it every collaboration page reports "ApplicationX sign-in is not
# configured for this deployment." See docs/APPLICATIONX-EMBED.md.
# LOGTO_APPLICATIONX_RESOURCE=

# Public origin of this app; also the origin of the /callback redirect URI
# registered in Logto. Defaults to http://localhost:3001.
# LOGTO_BASE_URL=http://localhost:3001

# Backend origin for server-to-server calls (the ID-token exchange at
# POST /api/auth/login). Defaults to API_URL, then NEXT_PUBLIC_API_URL,
# then http://localhost:8001. Inside Docker use the compose service name.
# API_BASE_URL=http://backend:8000
