# Browser-visible, non-secret application metadata only.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-a-turnstile-site-key

# Never prefix the OpenRouter key with NEXT_PUBLIC_.
# Local Worker development reads this from a gitignored .dev.vars file:
# OPENROUTER_API_KEY=replace-with-a-restricted-openrouter-key
