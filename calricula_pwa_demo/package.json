{
  "name": "calricula-pwa-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Calricula progressive web app demo",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "preview": "wrangler dev --ip 127.0.0.1",
    "build": "npm run build:next",
    "build:next": "next build --webpack",
    "postbuild": "node scripts/build-pwa.mjs && node scripts/validate-build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "test:e2e:full": "node scripts/run-release-e2e.mjs",
    "test:e2e:remote": "playwright test",
    "test:release-scripts": "vitest run --config vitest.config.ts scripts/*.test.mjs",
    "verify:foundation": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify": "npm run audit:production && npm run lint && npm run typecheck && npm run test:coverage && npm run test:worker && npm run build && npm run deploy:dry-run && npm run test:e2e:smoke",
    "verify:production": "node scripts/validate-build.mjs && node scripts/verify-production.mjs",
    "verify:production:local": "node scripts/validate-build.mjs && node scripts/verify-production.mjs --local",
    "verify:artifacts": "node scripts/validate-build.mjs && node scripts/validate-worker-bundle.mjs",
    "release:clean-generated": "node scripts/prepare-release-build.mjs",
    "release:fresh-checkout": "node scripts/verify-fresh-checkout.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run && node scripts/validate-worker-bundle.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "release:evidence:predeploy": "node scripts/release-evidence.mjs verify --phase predeploy",
    "release:evidence:complete": "node scripts/release-evidence.mjs verify --phase complete",
    "release:verify:deployed": "node scripts/release-deploy.mjs --verify-only",
    "release:verify:staged": "node scripts/release-deploy.mjs --stage --verify-only",
    "release:cancel:pending-no-change": "node scripts/release-deploy.mjs --cancel-pending-no-change",
    "deploy": "node scripts/release-deploy.mjs",
    "deploy:stage": "node scripts/release-deploy.mjs --stage",
    "deploy:bootstrap": "node scripts/release-deploy.mjs --bootstrap",
    "icons": "node scripts/generate-icons.mjs",
    "ai:discover": "node scripts/discover-openrouter-models.mjs",
    "ai:evaluate": "node scripts/ai-evaluate.mjs",
    "ai:canary": "node scripts/ai-canary.mjs",
    "ai:discover:record": "node scripts/release-evidence.mjs record discover",
    "ai:evaluate:record": "node scripts/release-evidence.mjs record evaluate",
    "ai:canary:record": "node scripts/release-evidence.mjs record canary",
    "lighthouse:local": "node scripts/run-lighthouse.mjs --local",
    "lighthouse:production": "node scripts/run-lighthouse.mjs",
    "lighthouse:assert": "node scripts/run-lighthouse.mjs --assert-only"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@headlessui/react": "2.2.10",
    "clsx": "2.1.1",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "framer-motion": "12.42.0",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "9.0.1",
    "tailwind-merge": "3.4.0",
    "workbox-window": "7.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vitest-pool-workers": "0.19.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/typography": "0.5.19",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.17",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-istanbul": "4.1.10",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "lighthouse": "13.3.0",
    "postcss": "8.5.25",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "workbox-build": "7.4.1",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "next": {
      "sharp": "0.35.0"
    }
  }
}
