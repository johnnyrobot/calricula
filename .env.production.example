# ===========================================
# Calricula - Production Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# ===========================================
# DATABASE (Required)
# ===========================================
DB_USER=calricula
DB_PASSWORD=your-secure-password-here
DB_NAME=calricula

# ===========================================
# GOOGLE AI (Required)
# ===========================================
GOOGLE_API_KEY=your-google-api-key
GEMINI_FILE_SEARCH_STORE_NAME=calricula-knowledge-base

# ===========================================
# LOGTO / OIDC AUTHENTICATION (Required, ADR-0001)
# ===========================================
# See docs/AUTH-LOGTO.md for Logto tenant setup.

# Backend
OIDC_ISSUER=https://your-tenant.logto.app/oidc
OIDC_AUDIENCE=https://api.calricula.local
OIDC_CLIENT_ID=your-logto-web-app-id
# Optional; defaults to OIDC_ISSUER + "/jwks"
# OIDC_JWKS_URL=
# Set to false once every Firebase-era user has signed in at least once
AUTH_LEGACY_RELINK=true

# Frontend (server-only; never prefixed NEXT_PUBLIC_)
LOGTO_ENDPOINT=https://your-tenant.logto.app/
LOGTO_APP_ID=your-logto-web-app-id
LOGTO_APP_SECRET=your-logto-app-secret
LOGTO_COOKIE_SECRET=generate-with-openssl-rand--base64-32
LOGTO_BASE_URL=https://calricula.example.com
LOGTO_API_RESOURCE=https://api.calricula.local
# ApplicationX API resource indicator; leave empty until that integration lands
LOGTO_APPLICATIONX_RESOURCE=

# Frontend (client-visible)
NEXT_PUBLIC_LOGTO_ENABLED=true

# ===========================================
# LOGGING (Optional)
# ===========================================
LOG_LEVEL=info
